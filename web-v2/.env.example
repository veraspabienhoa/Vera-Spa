# Public browser-safe Supabase values only. NEVER put service_role or DB passwords here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Existing/new Python API used for business-rule writes.
# Example: https://vera-api-xxxx-uc.a.run.app
VITE_VERA_API_BASE_URL=https://api.veraspa.vn

# Optional: set to 1 only for local UI development without backend connectivity.
VITE_VERA_DEMO_MODE=0
